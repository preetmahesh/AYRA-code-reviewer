{
  "name": "ayra-ai",
  "displayName": "Ayra",
  "description": "AI Code Review Assistant",
  "version": "0.0.1",
  "engines": { "vscode": "^1.74.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ayra-sidebar",
          "title": "Ayra",
          "icon": "$(sparkle)"
        }
      ]
    },
    "views": {
      "ayra-sidebar": [
        {
          "type": "webview",
          "id": "ayra.sidebar",
          "name": "Ayra"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  }
}